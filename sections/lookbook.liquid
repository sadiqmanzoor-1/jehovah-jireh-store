<div class="lookbook" id="lookbook">
  <div class="lookbook__inner page-width">
    {%- liquid
      assign lookbook_heading_words = section.settings.heading | split: ' '
      assign lookbook_heading_word_count = lookbook_heading_words | size
    -%}
    {%- if section.settings.heading != blank or section.settings.view_all_label != blank -%}
      <div class="lookbook__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="lookbook__heading">
            {%- if section.settings.accent_last_word and lookbook_heading_word_count > 1 -%}
              {%- assign lookbook_heading_last = lookbook_heading_words | last -%}
              {%- assign lookbook_heading_lead = section.settings.heading | remove: lookbook_heading_last | strip -%}
              {{- lookbook_heading_lead | escape }} <span class="lookbook__heading-accent">{{ lookbook_heading_last | escape }}</span>
            {%- else -%}
              {{- section.settings.heading | escape -}}
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- if section.settings.view_all_label != blank -%}
          <a
            href="{{ section.settings.view_all_link | default: routes.all_products_collection_url }}"
            class="lookbook__head-link"
          >
            {{- section.settings.view_all_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="lookbook__grid">
      {%- for block in section.blocks -%}
        <figure class="lookbook__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1200
              | image_tag:
                class: 'lookbook__image',
                loading: 'lazy',
                sizes: '(min-width: 750px) 50vw, 100vw',
                widths: '400, 600, 900, 1200'
            }}
          {%- else -%}
            {%- comment -%}
              Alternate between two of Dawn's built-in lifestyle placeholders so
              looks don't all render the same image before real photography is
              uploaded (richer placeholder treatment authorized for this section).
            {%- endcomment -%}
            {%- assign lookbook_placeholder_name = 'lifestyle-1' -%}
            {%- assign lookbook_placeholder_parity = forloop.index0 | modulo: 2 -%}
            {%- if lookbook_placeholder_parity == 1 -%}
              {%- assign lookbook_placeholder_name = 'lifestyle-2' -%}
            {%- endif -%}
            {{ lookbook_placeholder_name | placeholder_svg_tag: 'lookbook__image lookbook__image--placeholder' }}
          {%- endif -%}
          {%- if block.settings.caption != blank -%}
            <figcaption class="lookbook__caption">{{ block.settings.caption | escape }}</figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "class": "section-lookbook",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The lookbook" },
    {
      "type": "checkbox",
      "id": "accent_last_word",
      "label": "Accent the last word of the heading",
      "default": true
    },
    { "type": "text", "id": "view_all_label", "label": "View all link label", "default": "All looks" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [
    { "type": "look", "name": "Look", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "caption", "label": "Caption" }
    ] }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Lookbook", "blocks": [ { "type": "look" }, { "type": "look" } ] }]
}
{% endschema %}
